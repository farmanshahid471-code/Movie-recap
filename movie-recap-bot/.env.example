# Copy to .env and fill in. Secrets are loaded automatically by the CLI.

# --- LLM provider (for auto writing the recap script + Chinese translation) ---
# Use one of: ollama (free, local, no key) | openai | anthropic | deepseek | none
LLM_PROVIDER=ollama
MODEL_NAME=qwen2.5

# Ollama: free & fully local. No key needed.
#   Start the server:      ollama serve
#   Pull the model:        ollama pull qwen2.5
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional remote providers (used only if LLM_PROVIDER != ollama):
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- TTS provider: edge (free) | elevenlabs | openai ---
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Step D: Supabase (pgvector) semantic matching ---
# The semantic engine runs with a LOCAL store when these are empty (no setup).
# Set them to use hosted Postgres + pgvector as specced:
#   * SUPABASE_URL          -> https://<project>.supabase.co
#   * SUPABASE_SERVICE_KEY  -> Project Settings -> API -> service_role key
#   * (optional) SUPABASE_DB_URL -> direct connection string; when present the
#     pipeline auto-runs migrations/001_pgvector.sql (table + match_cues RPC).
#     Otherwise run that file once in the Supabase SQL editor by hand.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
