# Copy to .env and fill in. Secrets are loaded automatically by the CLI.

# --- LLM provider (for auto writing the recap script + Chinese translation) ---
# Use one of: ollama (free, local, no key) | openai | anthropic | deepseek | none
LLM_PROVIDER=ollama
MODEL_NAME=qwen2.5

# Ollama: free & fully local. No key needed.
#   Start the server:      ollama serve
#   Pull the model:        ollama pull qwen2.5
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional remote providers (used only if LLM_PROVIDER != ollama):
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- TTS provider: edge (free) | elevenlabs | openai ---
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
