# ============================================================================
# movie-recap-bot/.env.example
# Copy this file to ".env" in the SAME folder and fill in real values.
# Everything here is optional except the secrets you actually use.
# Never commit .env (git already ignores it); never paste keys into chat.
# ============================================================================

# --- Where files are stored (keep everything OFF the C: drive) --------------
# Leave both commented out to write next to this bot folder. On a small C:
# drive, point them at a big drive — all outputs, model weights, ffmpeg
# binaries and scratch then live under those roots:
#   output -> <output_dir>                 final <name>_<lang>.mp4 + _work/
#   cache  -> <output_dir>\..\cache        whisper/huggingface/static-ffmpeg
# (cache_dir "" in config.yaml behaves the same as CACHE_DIR below.)
# OUTPUT_DIR=D:\recap\output
# CACHE_DIR=D:\recap\cache

# --- LLM provider -----------------------------------------------------------
# deepseek= DEFAULT. Cheap, fast, and has reliable JSON mode, which the
#           section-by-section script pass depends on to hit the length target.
#           Get a key at platform.deepseek.com -> API keys.
# ollama  = free, local (start "ollama serve" first; default model qwen2.5).
#           Small local models often under-write the script, which makes the
#           video shorter than requested — use deepseek if length matters.
# groq    = FREE cloud (no credit card) — console.groq.com -> API key.
#           Very fast Llama-3.3-70B; free tier ~30 req/min (~25 calls per movie).
# gemini  = FREE cloud (no credit card) — aistudio.google.com -> Get API key.
#           Current default model: gemini-3.6-flash (gemini-2.5-flash is
#           retired for new API keys — Google returns a 404 for it).
#           Note: Google may use free-tier data for training.
# openai  = needs OPENAI_API_KEY
LLM_PROVIDER=deepseek
# Which model to use for the BIG steps (script generation etc.).
#   deepseek-chat      - fast, the right default
#   deepseek-reasoner  - slower, better on tangled plots
# For local Ollama instead: LLM_PROVIDER=ollama and MODEL_NAME=qwen2.5
MODEL_NAME=deepseek-chat
# Optional: a smaller/faster model for the Step A chunk-summary pass only.
# For local Ollama e.g. SUMMARY_MODEL=qwen2.5:3b; with DeepSeek leave unset so
# summaries use the main model (deepseek-chat). Overrides config.yaml chunking.model.
# SUMMARY_MODEL=qwen2.5:3b
# LLM_TIMEOUT=3600        # seconds per request; raise for slow machines
# --- DeepSeek token economy (billing) --------------------------------------
# Every LLM call already gets a per-job output cap (a script section gets only
# as many tokens as its word budget needs, etc.). These are the master knobs:
# LLM_MAX_TOKENS=4096     # hard cap on OUTPUT tokens per call (default 4096)
# LLM_TEMPERATURE=0.7     # 0.2-0.3 = more deterministic JSON; higher = more creative
# LLM_RETRIES=4           # retries only for transient 429/5xx/network errors
# RECAP_TOKEN_LOG=1       # print "~N in + ~N out tokens" after each LLM call
#                         # so you can verify nothing is being wasted

# Secrets (keep private):
DEEPSEEK_API_KEY=sk-...        # <-- REQUIRED with LLM_PROVIDER=deepseek
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...        (free: https://console.groq.com -> API Keys)
# GEMINI_API_KEY=AIza...      (free: https://aistudio.google.com -> Get API key)

# --- Ollama local server -----------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- TTS ---------------------------------------------------------------------
# edge = free Microsoft voices (default). elevenlabs / openai need keys:
# TTS_PROVIDER=edge
# ELEVENLABS_API_KEY=...
# OPENAI_API_KEY=...
# TTS voice + pacing live in config.yaml under narration (lang_voice / rate).

# --- Languages (en / zh / ar / es clips) -------------------------------------
# One recap run renders every language in language.target_languages
# (config.yaml). Every language has its own narrator (narration.lang_voice):
#   en  en-US-ChristopherNeural   zh  zh-CN-YunjianNeural
#   ar  ar-SA-HamedNeural (MSA)   es  es-MX-JorgeNeural (Latin America)
# Arabic/Spanish/Chinese clips are written NATIVELY in that language from a
# subtitle you provide:
#   1) name it next to the movie:  "Toy Story 5.ar.srt" / ".es.srt" / ".zh.srt"
#      (or type the path in Recap Studio Settings, / config.yaml language.sources,
#      / --subtitle-ar movie.ar.srt on the CLI), and
#   2) run with that language in target_languages / --langs.
# No subtitle for a non-English language = it is translated from the English
# recap instead (still fully dubbed + subtitled in that language).
# English always uses the movie's own dialogue (its .srt, else Whisper).

# --- Narration precision (Step A summary pass) -------------------------------
# How much of each transcript block is kept as story beats before the script
# is written. Default 0.6 = maximum detail (each beat also keeps its film
# timecode, which anchors the narration to the exact moment shown). Lower it
# (e.g. 0.35) for a lighter, cheaper run. 3-minute chunk windows are set in
# config.yaml under chunking (chunking.window_seconds).
# RECAP_SUMMARY_RATIO=0.6

# --- Vision pass (narrate what is ON SCREEN, not just what is said) ----------
# DeepSeek's API is text-only. To also narrate silent scenes, captions frames
# of the actual film with a vision-capable model and merges them into the beat
# list. Default provider = Google Gemini (multimodal, FREE tier):
#
#   1) Get a free API key:  https://aistudio.google.com -> Get API key
#   2) Add it here:         GEMINI_API_KEY=AIza...
#
# The key is read from movie-recap-bot/.env automatically; it is separate from
# your DeepSeek key. Tunables live in config.yaml under `vision:` (cadence,
# max_frames, width, frames_per_request). Quick env overrides:
# VISION_ENABLED=0          # turn the pass off without editing config.yaml
# VISION_MODEL=gemini-2.5-flash   # any multimodal Gemini/OpenAI-compat model
# Vision never bills DeepSeek: image tokens are consumed on the vision
# provider (free on the Gemini free tier; a paid key bills ~cents per movie).
# GEMINI_API_KEY=


# --- LEGACY vector store (Supabase pgvector) — no longer used -----------------
# The Step A-F engine maps narration to film moments with a chronological
# timeline, NOT embeddings — these keys are only for the retired vector
# matcher and can be left unset. Kept so old setups still boot:
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here
# SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-...pooler.supabase.com:5432/postgres
