[
  {
    "start": 0.1,
    "end": 5.2,
    "lines": [
      "一个十四岁的男孩詹姆斯在一场可怕的车祸中失去了父母。"
    ]
  },
  {
    "start": 5.15,
    "end": 7.975,
    "lines": [
      "他搬去和祖父杰佩托一起生活。"
    ]
  },
  {
    "start": 7.975,
    "end": 12.575,
    "lines": [
      "詹姆斯很快在邻居家交了两个朋友，但其中一个死于癌症。"
    ]
  },
  {
    "start": 12.575,
    "end": 15.25,
    "lines": [
      "另一个朋友搬到了别的城市。"
    ]
  },
  {
    "start": 15.25,
    "end": 19.913,
    "lines": [
      "就在那一天，杰佩托决定詹姆斯不能再失去任何人了。"
    ]
  },
  {
    "start": 19.913,
    "end": 25.35,
    "lines": [
      "他把自己锁在地下室里好几个星期，而那里从不许詹姆斯进入。"
    ]
  },
  {
    "start": 25.35,
    "end": 30.925,
    "lines": [
      "经过无数个日夜，杰佩托终于完成了那个永远不会抛弃孙子的造物。"
    ]
  },
  {
    "start": 30.925,
    "end": 34.638,
    "lines": [
      "一天傍晚，杰佩托带詹姆斯出门透透气。"
    ]
  },
  {
    "start": 34.638,
    "end": 38.638,
    "lines": [
      "他答应第二天要给他看一件非常特别的东西。"
    ]
  },
  {
    "start": 38.638,
    "end": 42.538,
    "lines": [
      "那天夜里，詹姆斯被屋里奇怪的声响惊醒。"
    ]
  },
  {
    "start": 42.538,
    "end": 46.113,
    "lines": [
      "他看到阴影里有个人影，一路追到了地下室。"
    ]
  },
  {
    "start": 46.112,
    "end": 51.762,
    "lines": [
      "让他震惊的是，一个名叫匹诺曹的活木偶走出来向他打招呼。"
    ]
  },
  {
    "start": 51.763,
    "end": 58.062,
    "lines": [
      "詹姆斯吓坏了，骂他是个可怕的东西，但杰佩托坚持说他是个真正的生命。"
    ]
  },
  {
    "start": 58.062,
    "end": 61.725,
    "lines": [
      "杰佩托恳求詹姆斯保守匹诺曹的秘密。"
    ]
  },
  {
    "start": 61.725,
    "end": 66.225,
    "lines": [
      "整个周末，两个男孩一起玩耍，成了最好的朋友。"
    ]
  },
  {
    "start": 66.225,
    "end": 69.938,
    "lines": [
      "匹诺曹看了一部关于动物保护族群的纪录片。"
    ]
  },
  {
    "start": 69.938,
    "end": 76.062,
    "lines": [
      "他认定詹姆斯就是他要守护的族群，无论如何都要保护他。"
    ]
  },
  {
    "start": 76.062,
    "end": 80.812,
    "lines": [
      "后来，匹诺曹在地下室发现了另一个木偶，木母。"
    ]
  },
  {
    "start": 80.812,
    "end": 87.65,
    "lines": [
      "木母告诉他，要成为一个真正的男孩，他需要皮肤、血液、牙齿和头发。"
    ]
  },
  {
    "start": 87.65,
    "end": 91.3,
    "lines": [
      "他必须从别人身上取来，穿戴在自己身上。"
    ]
  },
  {
    "start": 91.3,
    "end": 94.388,
    "lines": [
      "躲在阴影里的蟋蟀听到了每一句话。"
    ]
  },
  {
    "start": 94.388,
    "end": 97.375,
    "lines": [
      "匹诺曹求詹姆斯带他去学校。"
    ]
  },
  {
    "start": 97.375,
    "end": 100.75,
    "lines": [
      "詹姆斯把他藏进书包里，骗过了祖父。"
    ]
  },
  {
    "start": 100.75,
    "end": 105.237,
    "lines": [
      "在体育馆里，匹诺曹溜了出来，看着大人们锻炼。"
    ]
  },
  {
    "start": 105.237,
    "end": 110.65,
    "lines": [
      "一个女人发现了他，从跑步机上摔下来，被落下的杠铃压死了。"
    ]
  },
  {
    "start": 110.65,
    "end": 116.025,
    "lines": [
      "随后，欺负人的特雷和洛根找到了詹姆斯，毁掉了他的玩具。"
    ]
  },
  {
    "start": 116.025,
    "end": 121.013,
    "lines": [
      "他们嘲笑他，还威胁说如果他敢告诉大人就杀了他。"
    ]
  },
  {
    "start": 121.013,
    "end": 125.788,
    "lines": [
      "詹姆斯小声说希望那些少年都死掉，匹诺曹听到了。"
    ]
  },
  {
    "start": 125.787,
    "end": 130.612,
    "lines": [
      "那天夜里，匹诺曹决定要实现詹姆斯的每一个愿望。"
    ]
  },
  {
    "start": 130.613,
    "end": 134.963,
    "lines": [
      "在牙医诊所，匹诺曹看着詹姆斯痛苦地忍受着。"
    ]
  },
  {
    "start": 134.963,
    "end": 139.95,
    "lines": [
      "回家的路上，一个分心的司机撞了车，詹姆斯住进了医院。"
    ]
  },
  {
    "start": 139.95,
    "end": 144.375,
    "lines": [
      "匹诺曹得知肇事的是一个伤害过很多人的酒驾司机。"
    ]
  },
  {
    "start": 144.375,
    "end": 148.675,
    "lines": [
      "为了保护最好的朋友，匹诺曹找到了那个酒驾司机。"
    ]
  },
  {
    "start": 148.675,
    "end": 152.7,
    "lines": [
      "他挖出了那个男人的器官，好让自己变成真人。"
    ]
  },
  {
    "start": 152.7,
    "end": 156.4,
    "lines": [
      "接着他又去找牙医，取走了她的牙齿。"
    ]
  },
  {
    "start": 156.4,
    "end": 160.613,
    "lines": [
      "詹姆斯和朋友看了旧录像带，发现了杰佩托的真相。"
    ]
  },
  {
    "start": 160.613,
    "end": 165.05,
    "lines": [
      "他们的祖父试图把灵魂封进木偶，来欺骗死亡。"
    ]
  },
  {
    "start": 165.05,
    "end": 170.05,
    "lines": [
      "詹姆斯意识到，匹诺曹现在正追杀每一个伤害过他的人。"
    ]
  },
  {
    "start": 170.05,
    "end": 174.675,
    "lines": [
      "匹诺曹闯进洛根的家，在泳池边杀死了他的朋友们。"
    ]
  },
  {
    "start": 174.675,
    "end": 179.863,
    "lines": [
      "他又追杀阿曼达，然后是特雷，用可怕的方式结束了他们。"
    ]
  },
  {
    "start": 179.863,
    "end": 185.3,
    "lines": [
      "詹姆斯求匹诺曹停下来，但匹诺曹以为他想让自己杀更多人。"
    ]
  },
  {
    "start": 185.3,
    "end": 189.05,
    "lines": [
      "等杰佩托回到家时，匹诺曹已经不见了。"
    ]
  },
  {
    "start": 189.05,
    "end": 193.325,
    "lines": [
      "詹姆斯明白，这个木偶永远不会停止保护他。"
    ]
  },
  {
    "start": 193.325,
    "end": 197.262,
    "lines": [
      "这就是一个把怪物带到人间的男孩的故事。"
    ]
  }
]